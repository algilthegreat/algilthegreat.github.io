# URL publique du site (utilisée pour canonical, hreflang, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://algilthegreat.github.io

# Formulaires Formspree (https://formspree.io/f/…) — sans eux les formulaires affichent une erreur.
# À renseigner dans .env.local : ils sont intégrés au site par npm run deploy.
NEXT_PUBLIC_FORMSPREE_CONTACT=
NEXT_PUBLIC_FORMSPREE_NEWSLETTER=
